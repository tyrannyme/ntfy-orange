{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ntfy-orange",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  // Non-secret settings. Users and tokens are secrets: see README ("Deploy").
  "vars": {
    "NTFY_AUTH_DEFAULT_ACCESS": "deny-all",
    "NTFY_AUTH_ACCESS": "",
    "NTFY_CACHE_DURATION": "7d",
    "NTFY_KEEPALIVE_INTERVAL": "45s",
    "NTFY_ATTACHMENT_FILE_SIZE_LIMIT": "15M",
    "NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT": "250M",
    "NTFY_ATTACHMENT_EXPIRY_DURATION": "24h",
  },
}
